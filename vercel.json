{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "excludeFiles": "{.venv/**,venv/**,env/**,tests/**,.pytest_cache/**,__pycache__/**,*.pt,*.pth,*.bin,yolov8n.pt,recsys.db,.git/**,.agents/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ]
}
